<p>
  <label for="settings_step"><%= l(:label_done_ratio_step) %></label>
  <%= number_field_tag 'settings[step]', RedmineDoneRatioStep::Config.step,
                       id: 'settings_step', min: 1, max: 100, step: 1, required: true %>
  <em class="info"><%= l(:text_done_ratio_step_info) %></em>
</p>

<p>
  <label for="settings_mode"><%= l(:label_done_ratio_step_mode) %></label>
  <%= select_tag 'settings[mode]',
                 options_for_select([[l(:label_done_ratio_step_mode_slider), 'slider'],
                                     [l(:label_done_ratio_step_mode_number), 'number']],
                                    RedmineDoneRatioStep::Config.mode),
                 id: 'settings_mode' %>
</p>
